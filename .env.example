# ==========================================================
# SEKTA — Environment Variables
# Salin file ini menjadi `.env` lalu isi dengan nilai asli.
# Jangan commit `.env` ke repository.
# ==========================================================

# ---- Supabase -------------------------------------------------
# Buka https://supabase.com/dashboard > pilih project Anda >
# Project Settings > API untuk mendapatkan URL & anon key.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Kunci rahasia server-only (JANGAN dipakai di kode client).
# Dipakai script `scripts/create-content.mjs` untuk insert konten.
# Ambil di Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App ---------------------------------------------------------
# Port untuk `npm run dev` dan `npm run preview` (default 5173)
PORT=5173

# ---- PostHog (product analytics) --------------------------------
# Buat project di https://posthog.com (region EU/US) lalu isi:
#   PUBLIC_POSTHOG_KEY  = Project API Key (Project Settings > API keys)
#   PUBLIC_POSTHOG_HOST = https://eu.i.posthog.com atau https://us.i.posthog.com
PUBLIC_POSTHOG_KEY=your-posthog-project-key
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---- PostHog monitoring (server-side, untuk halaman /monitoring) ---
# Personal API Key: posthog.com > Project Settings > Personal API Keys (mulai phx_...)
# Project ID: posthog.com > Project Settings > General
POSTHOG_PROJECT_ID=
POSTHOG_API_KEY=
